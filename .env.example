# ─────────────────────────────────────────────────────────────
# Nemu.in — environment contract
# Copy to `.env.local` and fill. Never commit the filled version.
# ─────────────────────────────────────────────────────────────

# Public site origin. Used to build the Google OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
# Used exclusively by the God Mode dashboard for credit injection.
SUPABASE_SERVICE_ROLE_KEY=

# ── Business discovery ──────────────────────────────────────
# Geoapify: 3,000 requests/day free, NO billing card required.
# Get one at geoapify.com. Results are merged with a parallel
# OpenStreetMap Overpass query, which needs no key at all — two
# free sources beat one because phone-number coverage is the
# scarcest field in Indonesian map data.
GEOAPIFY_API_KEY=
#
# Google Places is OPTIONAL and left blank on purpose: it returns
# nothing until a billing card is attached to the Cloud project.
#
# Only fill this if you later add a billing card to Google Cloud
# and want Places' richer data (real ratings, better phone
# coverage). The moment a key exists, the app prefers Places
# automatically — no code change.
# console.cloud.google.com → enable "Places API (New)"
GOOGLE_PLACES_API_KEY=

# ── Mapbox (peta) ───────────────────────────────────────────
# Public token (starts with pk.). 50,000 map loads/month free.
# NEVER put a secret token (sk.) here — anything prefixed
# NEXT_PUBLIC_ is compiled into the browser bundle and visible to
# every visitor.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Gemini dual-key load balancer ───────────────────────────
# Two free-tier keys from aistudio.google.com, ideally on two
# separate Google accounts so the per-key rate limits stack.
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=

# Model routing. Lite handles cheap classification, standard
# handles pitch writing and the deep audit.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.5-flash

# ── God Mode ────────────────────────────────────────────────
# Email that gets auto-promoted to super_admin on first sign-in.
SUPER_ADMIN_EMAIL=
